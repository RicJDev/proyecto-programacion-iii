generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model State {
  id           Int           @id @default(autoincrement()) @map("id_state")
  name         String        @db.VarChar(150)
  municipalities Municipality[]

  @@map("states")
}

model Municipality {
  id        Int      @id @default(autoincrement()) @map("id_municipality")
  name      String   @db.VarChar(150)
  idState   Int      @map("id_state")
  state     State    @relation(fields: [idState], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parishes  Parish[]

  @@map("municipalities")
}

model Parish {
  id             Int            @id @default(autoincrement()) @map("id_parish")
  name           String         @db.VarChar(150)
  idMunicipality Int            @map("id_municipality")
  municipality   Municipality   @relation(fields: [idMunicipality], references: [id], onDelete: Cascade, onUpdate: Cascade)
  healthCenters  HealthCenter[]

  @@map("parishes")
}

model HealthCenter {
  id          Int          @id @default(autoincrement()) @map("id_center")
  name        String       @db.VarChar(200)
  address     String       @db.Text
  idParish    Int          @map("id_parish")
  parish      Parish       @relation(fields: [idParish], references: [id], onDelete: Restrict, onUpdate: Cascade)
  immunizations Immunization[]

  @@map("health_centers")
}

model Recipient {
  id                  Int                  @id @default(autoincrement()) @map("id_person")
  name                String               @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  identificationNumber String              @unique @map("identification_number") @db.VarChar(50)
  
  immunizations       Immunization[]
  medicalExams        MedicalExam[]
  medicalCertificates MedicalCertificate[]

  @@map("recipients")
}

model Vaccine {
  id            Int            @id @default(autoincrement()) @map("id_vaccine")
  name          String         @db.VarChar(150)
  type          String         @db.VarChar(100)
  immunizations Immunization[]

  @@map("vaccines")
}

model Immunization {
  idDose       Int               @id @default(autoincrement()) @map("id_dose")
  idPerson     Int               @map("id_person")
  idVaccine    Int               @map("id_vaccine")
  dateTime     DateTime          @map("date_time") @db.DateTime
  idCenter     Int               @map("id_center")

  recipient    Recipient         @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vaccine      Vaccine           @relation(fields: [idVaccine], references: [id], onDelete: Restrict, onUpdate: Cascade)
  healthCenter HealthCenter      @relation(fields: [idCenter], references: [id], onDelete: Restrict, onUpdate: Cascade)
  certificates MedicalCertificate[]

  @@map("immunizations")
}

model MedicalExam {
  id          Int                  @id @default(autoincrement()) @map("id_exam")
  data        String               @db.LongText
  idPerson    Int                  @map("id_person")

  recipient   Recipient            @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)
  certificates MedicalCertificate[]

  @@map("medical_exams")
}

model MedicalCertificate {
  id          Int          @id @default(autoincrement()) @map("id_certificate")
  idExam      Int          @map("id_exam")
  idDose      Int          @map("id_dose")
  code        String       @unique @db.VarChar(100)
  idPerson    Int          @map("id_person")

  exam        MedicalExam  @relation(fields: [idExam], references: [id], onDelete: Cascade, onUpdate: Cascade)
  immunization Immunization @relation(fields: [idDose], references: [idDose], onDelete: Restrict, onUpdate: Cascade)
  recipient   Recipient    @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("medical_certificates")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp

  roles Role[]

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(255)

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  roles Role[]

  @@map("permissions")
}
