generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// --- AUTENTICACIÓN Y ROLES ---

model User {
  id           Int      @id @default(autoincrement()) @map("id")
  name         String   @map("nombre") @db.VarChar(150)
  email        String   @unique @map("correo") @db.VarChar(150)
  passwordHash String   @map("hash_contrasena") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamp

  userRoles          UserRole[]
  userStates         UserState[]
  userMunicipalities UserMunicipality[]
  userParishes       UserParish[]
  userCenters        UserCenter[]

  @@map("usuario")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("id")
  name        String  @unique @map("nombre") @db.VarChar(100)
  description String? @map("descripcion") @db.VarChar(255)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("rol")
}

model Permission {
  id          Int     @id @default(autoincrement()) @map("id")
  name        String  @unique @map("nombre") @db.VarChar(100)
  description String? @map("descripcion") @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permiso")
}

model UserRole {
  id     Int @id @default(autoincrement()) @map("id")
  idUser Int @map("id_usuario")
  idRole Int @map("id_rol")

  user User @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [idRole], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idUser, idRole])
  @@map("usuario_rol")
}

model RolePermission {
  id           Int @id @default(autoincrement()) @map("id")
  idRole       Int @map("id_rol")
  idPermission Int @map("id_permiso")

  role       Role       @relation(fields: [idRole], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [idPermission], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idRole, idPermission])
  @@map("rol_permiso")
}

// --- UBICACIÓN GEOGRÁFICA ---

model State {
  id             Int            @id @default(autoincrement()) @map("id")
  name           String         @map("nombre") @db.VarChar(150)
  municipalities Municipality[]
  userStates     UserState[]

  @@map("estado")
}

model Municipality {
  id      Int    @id @default(autoincrement()) @map("id")
  name    String @map("nombre") @db.VarChar(150)
  idState Int    @map("id_estado")

  state              State              @relation(fields: [idState], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parishes           Parish[]
  userMunicipalities UserMunicipality[]

  @@map("municipio")
}

model Parish {
  id             Int    @id @default(autoincrement()) @map("id")
  name           String @map("nombre") @db.VarChar(150)
  idMunicipality Int    @map("id_municipio")

  municipality  Municipality   @relation(fields: [idMunicipality], references: [id], onDelete: Cascade, onUpdate: Cascade)
  healthCenters HealthCenter[]
  userParishes  UserParish[]

  @@map("parroquia")
}

model HealthCenter {
  id       Int    @id @default(autoincrement()) @map("id")
  idParish Int    @map("id_parroquia")
  name     String @map("nombre") @db.VarChar(200)
  address  String @map("direccion") @db.Text

  parish        Parish         @relation(fields: [idParish], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventories   Inventory[]
  shipments     Shipment[]
  immunizations Immunization[]
  userCenters   UserCenter[]

  @@map("centro_salud")
}

// --- ALCANCE GEOGRÁFICO DE USUARIOS ---

model UserState {
  id      Int @id @default(autoincrement()) @map("id")
  idUser  Int @map("id_usuario")
  idState Int @map("id_estado")

  user  User  @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  state State @relation(fields: [idState], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idUser, idState])
  @@map("usuario_estado")
}

model UserMunicipality {
  id             Int @id @default(autoincrement()) @map("id")
  idUser         Int @map("id_usuario")
  idMunicipality Int @map("id_municipio")

  user         User         @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  municipality Municipality @relation(fields: [idMunicipality], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idUser, idMunicipality])
  @@map("usuario_municipio")
}

model UserParish {
  id       Int @id @default(autoincrement()) @map("id")
  idUser   Int @map("id_usuario")
  idParish Int @map("id_parroquia")

  user   User   @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parish Parish @relation(fields: [idParish], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idUser, idParish])
  @@map("usuario_parroquia")
}

model UserCenter {
  id             Int @id @default(autoincrement()) @map("id")
  idUser         Int @map("id_usuario")
  idHealthCenter Int @map("id_centro_salud")

  user         User         @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  healthCenter HealthCenter @relation(fields: [idHealthCenter], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idUser, idHealthCenter])
  @@map("usuario_centro")
}

// --- PERSONAS Y REPRESENTACIONES ---

model Person {
  id                   Int      @id @default(autoincrement()) @map("id")
  genre                String   @map("genero") @db.Char(1)
  weight               Decimal  @default(0) @map("peso")
  birthday             DateTime @map("fecha_nacimiento")
  firstName            String   @map("primer_nombre") @db.VarChar(100)
  secondName           String?  @map("segundo_nombre") @db.VarChar(100)
  lastName             String   @map("primer_apellido") @db.VarChar(100)
  secondLastName       String?  @map("segundo_apellido") @db.VarChar(100)
  identificationNumber String?  @unique @map("cedula_de_identidad") @db.VarChar(50)

  representatives     Representation[]     @relation("RepresentedToRepresentative")
  represented         Representation[]     @relation("RepresentativeToRepresented")
  vaccineCards        VaccineCard[]
  medicalCertificates MedicalCertificate[]
  medicalExamResults  MedicalExamResult[]

  @@map("persona")
}

model Representation {
  id               Int     @id @default(autoincrement()) @map("id")
  idRepresentative Int     @map("id_representante")
  idRepresented    Int     @map("id_representado")
  relationType     String? @map("tipo_relacion") @db.VarChar(50)

  representative Person @relation("RepresentativeToRepresented", fields: [idRepresentative], references: [id], onDelete: Cascade, onUpdate: Cascade)
  represented    Person @relation("RepresentedToRepresentative", fields: [idRepresented], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idRepresentative, idRepresented])
  @@map("representacion")
}

// --- VACUNAS Y ESQUEMAS ---

model Vaccine {
  id   Int    @id @default(autoincrement()) @map("id")
  name String @map("nombre") @db.VarChar(150)
  type String @map("tipo") @db.VarChar(100)

  batches                     Batch[]
  vaccinationScheduleVaccines VaccinationScheduleVaccine[]

  @@map("vacuna")
}

model VaccinationSchedule {
  id            Int      @id @default(autoincrement()) @map("id")
  ageRange      String   @map("rango_edad") @db.VarChar(50)
  publishedDate DateTime @map("fecha_publicacion")

  vaccinationScheduleVaccines VaccinationScheduleVaccine[]
  vaccineCards                VaccineCard[]

  @@map("esquema_vacunacion")
}

model VaccinationScheduleVaccine {
  id                    Int @id @default(autoincrement()) @map("id")
  idVaccinationSchedule Int @map("id_esquema_vacunacion")
  idVaccine             Int @map("id_vacuna")

  vaccinationSchedule VaccinationSchedule @relation(fields: [idVaccinationSchedule], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vaccine             Vaccine             @relation(fields: [idVaccine], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idVaccinationSchedule, idVaccine])
  @@map("esquema_vacunacion_vacuna")
}

model Batch {
  id             Int      @id @default(autoincrement()) @map("id")
  idVaccine      Int      @map("id_vacuna")
  lotNumber      String   @map("numero_lote") @db.VarChar(100)
  expirationDate DateTime @map("fecha_expiracion") @db.Date

  vaccine       Vaccine        @relation(fields: [idVaccine], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inventories   Inventory[]
  shipmentItems ShipmentItem[]
  immunizations Immunization[]

  @@map("lote")
}

model VaccineCard {
  id                    Int      @id @default(autoincrement()) @map("id")
  idPerson              Int      @map("id_persona")
  idVaccinationSchedule Int      @map("id_esquema_vacunacion")
  status                String   @map("estatus") @db.VarChar(50)
  emissionDate          DateTime @map("fecha_emision")
  code                  String   @unique @map("codigo") @db.VarChar(100)

  person              Person              @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vaccinationSchedule VaccinationSchedule @relation(fields: [idVaccinationSchedule], references: [id], onDelete: Cascade, onUpdate: Cascade)
  immunizations       Immunization[]

  @@map("tarjeta_vacunacion")
}

// --- INVENTARIO Y ENVÍOS ---

model Inventory {
  id                Int @id @default(autoincrement()) @map("id")
  idHealthCenter    Int @map("id_centro_salud")
  idBatch           Int @map("id_lote")
  quantityAvailable Int @map("cantidad_disponible")

  healthCenter HealthCenter @relation(fields: [idHealthCenter], references: [id], onDelete: Cascade, onUpdate: Cascade)
  batch        Batch        @relation(fields: [idBatch], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([idHealthCenter, idBatch])
  @@map("inventario")
}

model Shipment {
  id         Int      @id @default(autoincrement()) @map("id")
  idCenter   Int      @map("id_centro_salud")
  orderCode  String   @map("codigo_orden") @db.VarChar(100)
  senderName String   @map("nombre_remitente") @db.VarChar(150)
  date       DateTime @map("fecha")
  status     String   @map("estatus") @db.VarChar(50)

  healthCenter  HealthCenter   @relation(fields: [idCenter], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shipmentItems ShipmentItem[]

  @@map("envio")
}

model ShipmentItem {
  id         Int @id @default(autoincrement()) @map("id")
  idShipment Int @map("id_envio")
  idBatch    Int @map("id_lote")
  quantity   Int @map("cantidad")

  shipment Shipment @relation(fields: [idShipment], references: [id], onDelete: Cascade, onUpdate: Cascade)
  batch    Batch    @relation(fields: [idBatch], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("detalle_envio")
}

// --- INMUNIZACIONES Y EXÁMENES MÉDICOS ---

model Immunization {
  id             Int      @id @default(autoincrement()) @map("id")
  idVaccineCard  Int      @map("id_tarjeta_vacunacion")
  idBatch        Int      @map("id_lote")
  idHealthCenter Int      @map("id_centro_salud")
  dateTime       DateTime @map("fecha_hora")

  vaccineCard  VaccineCard  @relation(fields: [idVaccineCard], references: [id], onDelete: Cascade, onUpdate: Cascade)
  batch        Batch        @relation(fields: [idBatch], references: [id], onDelete: Restrict, onUpdate: Cascade)
  healthCenter HealthCenter @relation(fields: [idHealthCenter], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("inmunizacion")
}

model MedicalExam {
  id          Int     @id @default(autoincrement()) @map("id")
  name        String  @map("nombre") @db.VarChar(100)
  description String? @map("descripcion") @db.VarChar(255)

  parameters MedicalExamParameter[]

  @@map("examen_medico")
}

model MedicalExamParameter {
  id            Int     @id @default(autoincrement()) @map("id")
  idMedicalExam Int     @map("id_examen_medico")
  min           Decimal @map("minimo")
  max           Decimal @map("maximo")

  medicalExam MedicalExam         @relation(fields: [idMedicalExam], references: [id], onDelete: Cascade, onUpdate: Cascade)
  results     MedicalExamResult[]

  @@map("parametro_examen_medico")
}

model MedicalCertificate {
  id       Int      @id @default(autoincrement()) @map("id")
  idPerson Int      @map("id_persona")
  date     DateTime @map("fecha")
  code     String   @unique @map("codigo") @db.VarChar(100)

  person Person @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("certificado_medico")
}

model MedicalExamResult {
  id                     Int      @id @default(autoincrement()) @map("id")
  idPerson               Int      @map("id_persona")
  idMedicalExamParameter Int      @map("id_parametro_examen_medico")
  value                  Decimal  @map("valor")
  date                   DateTime @map("fecha")

  person               Person               @relation(fields: [idPerson], references: [id], onDelete: Cascade, onUpdate: Cascade)
  medicalExamParameter MedicalExamParameter @relation(fields: [idMedicalExamParameter], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("resultado_examen_medico")
}
